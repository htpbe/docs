    {
      "name": "Testing (Test API Key)",
      "description": "Use your test API key (`htpbe_test_...`) with these predefined mock URLs. No real PDF is downloaded, no quota is consumed, responses are deterministic. IDs are fixed UUID v4 values — you can hardcode them in automated tests.",
      "item": [
        {
          "name": "POST Analyze — clean.pdf (intact)",
          "event": [
