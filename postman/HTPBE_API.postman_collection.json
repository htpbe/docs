        {
          "name": "POST Analyze — inconclusive.pdf (consumer software)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{test_api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
