{
  "info": {
    "name": "HTPBE API",
    "description": "PDF authenticity checker API — detects post-creation modifications in PDF documents.\n\n**Base URL:** `https://api.htpbe.tech/v1`\n\n**Authentication:** Set `api_key` variable to your live key (`htpbe_live_...`) and `test_api_key` to your test key (`htpbe_test_...`).\n\n**Two-step flow:** `POST /analyze` returns only `{ \"id\": \"...\" }`. Call `GET /result/{id}` to get the full verdict. The test script on the Analyze request automatically sets the `check_id` variable.\n\nGet your API keys at https://htpbe.tech/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.htpbe.tech/v1",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "htpbe_live_YOUR_KEY",
      "type": "string",
      "description": "Your live API key. Get it at https://htpbe.tech/dashboard/api-keys"
    },
    {
      "key": "test_api_key",
      "value": "htpbe_test_YOUR_KEY",
      "type": "string",
      "description": "Your test API key. Get it at https://htpbe.tech/dashboard/api-keys"
    },
    {
      "key": "check_id",
      "value": "",
      "type": "string",
      "description": "Auto-filled by the 'Analyze PDF' test script after a successful POST /analyze"
    }
  ],
  "item": [
    {
      "name": "Analyze PDF",
      "item": [
        {
          "name": "POST Analyze — minimal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save check ID so 'Get Result' request works immediately",
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('check_id', json.id);",
                  "    pm.test('Response has id', () => pm.expect(json.id).to.be.a('string'));",
                  "    console.log('check_id set to:', json.id);",
                  "}",
                  "",
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location header present', () => pm.response.to.have.header('Location'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/documents/contract.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analyze",
              "host": ["{{base_url}}"],
              "path": ["analyze"]
            },
            "description": "Submit a PDF URL for analysis. Returns a check ID. Call `GET /result/{id}` to retrieve the verdict.\n\n**Auto-saves `check_id`** — the test script captures the returned `id` into the collection variable so the 'Get Result' request works immediately after."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Location",
                  "value": "https://api.htpbe.tech/v1/result/3f9c8b7a-2e1d-4c5f-9b8e-7a6d5c4b3a21"
                }
              ],
              "body": "{\n  \"id\": \"3f9c8b7a-2e1d-4c5f-9b8e-7a6d5c4b3a21\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "POST Analyze — with original_filename",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('check_id', json.id);",
                  "    pm.test('Response has id', () => pm.expect(json.id).to.be.a('string'));",
                  "}",
                  "",
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/documents/abc123-uuid.pdf\",\n  \"original_filename\": \"invoice-2024-01.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/analyze",
              "host": ["{{base_url}}"],
              "path": ["analyze"]
            },
            "description": "Use `original_filename` when the URL does not reflect the real filename (e.g. after upload to S3/R2 with a UUID key). The provided name is stored and returned in results."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Get Result",
      "item": [
        {
          "name": "GET Result by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Has status field', () => pm.expect(['intact', 'modified', 'inconclusive']).to.include(json.status));",
                  "    pm.test('Has modification_confidence', () => pm.expect(json).to.have.property('modification_confidence'));",
                  "    pm.test('Has modification_markers array', () => pm.expect(json.modification_markers).to.be.an('array'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/result/{{check_id}}",
              "host": ["{{base_url}}"],
              "path": ["result", "{{check_id}}"]
            },
            "description": "Retrieve the full analysis result for a check. `check_id` is auto-set by the 'POST Analyze' test script, or paste a UUID directly.\n\n**Key verdict fields:**\n- `status`: `intact` | `modified` | `inconclusive`\n- `modification_confidence`: `certain` | `high` | `none` | `null`\n- `modification_markers`: array of specific findings, strongest first\n- `status_reason`: only present when `status === \"inconclusive\"`"
          },
          "response": [
            {
              "name": "200 OK — modified (certain confidence)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"506a6b1b-1360-48a2-b389-abb346f85d04\",\n  \"filename\": \"contract.pdf\",\n  \"check_date\": 1736542583,\n  \"file_size\": 245632,\n  \"algorithm_version\": \"2.11.8\",\n  \"current_algorithm_version\": \"2.11.8\",\n  \"status\": \"modified\",\n  \"origin\": {\n    \"type\": \"institutional\",\n    \"software\": null\n  },\n  \"creation_date\": 1704110400,\n  \"modification_date\": 1707840000,\n  \"creator\": \"Adobe Acrobat Pro DC\",\n  \"producer\": \"Adobe PDF Library 15.0\",\n  \"modification_confidence\": \"certain\",\n  \"date_sequence_valid\": true,\n  \"metadata_completeness_score\": 90,\n  \"xref_count\": 2,\n  \"has_incremental_updates\": true,\n  \"update_chain_length\": 3,\n  \"pdf_version\": \"1.7\",\n  \"has_digital_signature\": false,\n  \"signature_count\": 0,\n  \"signature_removed\": true,\n  \"modifications_after_signature\": false,\n  \"page_count\": 12,\n  \"object_count\": 487,\n  \"has_javascript\": false,\n  \"has_embedded_files\": false,\n  \"modification_markers\": [\n    \"HTPBE_SIGNATURE_REMOVED\",\n    \"HTPBE_DATES_DISAGREE\"\n  ]\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "200 OK — intact",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"b7e2d8f1-2e1d-4c5f-9b8e-7a6d5c4b3a21\",\n  \"filename\": \"original-report.pdf\",\n  \"check_date\": 1736542000,\n  \"file_size\": 1048576,\n  \"algorithm_version\": \"2.11.8\",\n  \"current_algorithm_version\": \"2.11.8\",\n  \"status\": \"intact\",\n  \"origin\": {\n    \"type\": \"institutional\",\n    \"software\": null\n  },\n  \"creation_date\": 1735689600,\n  \"modification_date\": 1735689600,\n  \"creator\": \"Adobe Acrobat Pro DC\",\n  \"producer\": \"Adobe PDF Library 15.0\",\n  \"modification_confidence\": \"none\",\n  \"date_sequence_valid\": true,\n  \"metadata_completeness_score\": 92,\n  \"xref_count\": 1,\n  \"has_incremental_updates\": false,\n  \"update_chain_length\": 1,\n  \"pdf_version\": \"1.7\",\n  \"has_digital_signature\": true,\n  \"signature_count\": 1,\n  \"signature_removed\": false,\n  \"modifications_after_signature\": false,\n  \"page_count\": 8,\n  \"object_count\": 320,\n  \"has_javascript\": false,\n  \"has_embedded_files\": false,\n  \"modification_markers\": []\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "200 OK — inconclusive (consumer software)",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"00000000-0000-4000-8000-000000000011\",\n  \"filename\": \"spreadsheet-export.pdf\",\n  \"check_date\": null,\n  \"file_size\": 204800,\n  \"algorithm_version\": \"2.11.8\",\n  \"current_algorithm_version\": \"2.11.8\",\n  \"status\": \"inconclusive\",\n  \"status_reason\": \"consumer_software_origin\",\n  \"origin\": {\n    \"type\": \"consumer_software\",\n    \"software\": \"Microsoft Excel\"\n  },\n  \"creation_date\": 1709283600,\n  \"modification_date\": 1709283600,\n  \"creator\": \"Microsoft Excel 2019\",\n  \"producer\": \"Microsoft: Print To PDF\",\n  \"modification_confidence\": \"none\",\n  \"date_sequence_valid\": true,\n  \"metadata_completeness_score\": 65,\n  \"xref_count\": 1,\n  \"has_incremental_updates\": false,\n  \"update_chain_length\": 1,\n  \"pdf_version\": \"1.7\",\n  \"has_digital_signature\": false,\n  \"signature_count\": 0,\n  \"signature_removed\": false,\n  \"modifications_after_signature\": false,\n  \"page_count\": 1,\n  \"object_count\": 82,\n  \"has_javascript\": false,\n  \"has_embedded_files\": false,\n  \"modification_markers\": []\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        }
      ]
    },
    {
      "name": "List Checks",
      "item": [
        {
          "name": "GET Checks — default (last 100)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.test('Response has data array', () => pm.expect(json.data).to.be.an('array'));",
                  "    pm.test('Response has total', () => pm.expect(json.total).to.be.a('number'));",
                  "    pm.test('Response has has_more', () => pm.expect(json.has_more).to.be.a('boolean'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/checks",
              "host": ["{{base_url}}"],
              "path": ["checks"]
            },
            "description": "Returns the first 100 checks (newest first). Use `has_more` and `offset` to paginate."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": [\n    {\n      \"id\": \"a3f5c9d2-1360-48a2-b389-abb346f85d04\",\n      \"filename\": \"invoice-2024-01.pdf\",\n      \"check_date\": 1738368000,\n      \"status\": \"modified\",\n      \"metadata_completeness_score\": 85,\n      \"creator\": \"Microsoft Word for Microsoft 365\",\n      \"producer\": \"Adobe PDF Library 15.0\",\n      \"file_size\": 524288,\n      \"page_count\": 5,\n      \"pdf_version\": \"1.7\",\n      \"creation_date\": 1735689600,\n      \"modification_date\": 1738281600,\n      \"has_javascript\": false,\n      \"has_digital_signature\": true,\n      \"has_embedded_files\": false,\n      \"has_incremental_updates\": true,\n      \"update_chain_length\": 3,\n      \"object_count\": 234\n    },\n    {\n      \"id\": \"b7e2d8f1-2e1d-4c5f-9b8e-7a6d5c4b3a21\",\n      \"filename\": \"contract.pdf\",\n      \"check_date\": 1738281600,\n      \"status\": \"intact\",\n      \"metadata_completeness_score\": 92,\n      \"creator\": \"Adobe Acrobat Pro DC\",\n      \"producer\": \"Adobe PDF Library 15.0\",\n      \"file_size\": 1048576,\n      \"page_count\": 12,\n      \"pdf_version\": \"1.7\",\n      \"creation_date\": 1735689600,\n      \"modification_date\": 1735689600,\n      \"has_javascript\": false,\n      \"has_digital_signature\": true,\n      \"has_embedded_files\": false,\n      \"has_incremental_updates\": false,\n      \"update_chain_length\": 1,\n      \"object_count\": 567\n    }\n  ],\n  \"total\": 1250,\n  \"limit\": 100,\n  \"offset\": 0,\n  \"has_more\": true\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },
        {
          "name": "GET Checks — filter by status=modified",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{api_key}}"
              }
            ],
